<comment>
problem   = 1D ambipolar diffusion convergence test (iprob=1)
reference = Bai & Stone 2011 (ApJ 736, 144)

<job>
basename  = field_diffusion

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 1
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<time>
evolution  = kinematic
integrator = rk2
cfl_number = 0.4
tlim       = 0.1

<mhd>
eos                 = ideal
gamma               = 1.6666666666666667
reconstruct         = plm
rsolver             = advect
ambipolar_diffusion = 0.01

<problem>
iprob  = 1
B0     = 1.0
amp    = 0.01
sigma  = 0.1
x0     = 0.5
B3bg   = 1.0

<output1>
file_type   = tab
variable    = mhd_bcc
data_format = %14.8e
dt          = 0.25
slice_x2    = 0.0
slice_x3    = 0.0
