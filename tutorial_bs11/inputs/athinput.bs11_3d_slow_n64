<comment>
Bai & Stone 2011 (ApJ 736, 144) -- Section 2.3.2: Damping of MHD Waves
3D oblique slow magnetosonic wave, rightgoing (wave_flag=4), N=64^3

Domain [0, sqrt(3)]^3, ang_3=45 deg, ang_2~35.26 deg, lx=1, k_par=2*pi (same as 1D/2D)
Analytic damping rate: Gamma_s = 1.3*pi^2/100 ~= 0.128

<job>
basename  = slow_3d_n64

<problem>
pgen_name = linear_wave
wave_flag = 4         # rightgoing slow wave: eigenvalue[4] = v1 + cs = 0+0.5 = 0.5
amp       = 1.0e-4
dens      = 1.0
pgas      = 0.6
bx0       = 1.0
by0       = 1.41421356237309504
bz0       = 0.5

<mesh>
nghost    = 2
nx1       = 64
x1min     = 0.0
x1max     = 1.7320508075688772    # sqrt(3)
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 64
x2min     = 0.0
x2max     = 1.7320508075688772    # sqrt(3)
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 64
x3min     = 0.0
x3max     = 1.7320508075688772    # sqrt(3)
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
tlim       = 2.5     # actual_tlim = 2.5 * (1.0/0.5) = 5.0 code units

<mhd>
eos                 = ideal
gamma               = 1.6666666666666667
reconstruct         = plm
rsolver             = hlld
ambipolar_diffusion = 0.0325

<output1>
file_type   = tab
variable    = mhd_bcc
data_format = %14.8e
dt          = 0.1
slice_x2    = 0.0
slice_x3    = 0.0
